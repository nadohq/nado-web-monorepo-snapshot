{
  "name": "nado-web-monorepo",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{js,json,jsx,ts,tsx,css,md}\" --log-level warn",
    "format:check": "prettier --check \"**/*.{js,json,jsx,ts,tsx,css,md}\"",
    "link-local-sdk": "./update-sdk-links.sh",
    "unlink-local-sdk": "UNLINK=true ./update-sdk-links.sh",
    "depcheck": "knip --dependencies",
    "depcheck:fix": "knip --dependencies --fix",
    "depcruise:all": "depcruise packages/* apps/*"
  },
  "devDependencies": {
    "dependency-cruiser": "17.4.3",
    "husky": "9.1.7",
    "knip": "6.16.0",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.9.16"
  },
  "engines": {
    "node": "24.x"
  },
  "catalog": {
    "@happy-dom/global-registrator": "20.10.1",
    "@next/bundle-analyzer": "16.2.7",
    "@phosphor-icons/react": "2.1.10",
    "@privy-io/react-auth": "3.32.2",
    "@privy-io/wagmi": "4.0.13",
    "@radix-ui/react-checkbox": "1.3.4",
    "@radix-ui/react-dialog": "1.1.16",
    "@radix-ui/react-popover": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.0",
    "@radix-ui/react-tabs": "1.1.14",
    "@tailwindcss/postcss": "4.3.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/lodash": "4.17.24",
    "@types/node": "24.13.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@nadohq/client": "0.22.2",
    "ahooks": "3.9.7",
    "bignumber.js": "11.1.1",
    "date-fns": "4.4.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.9.16",
    "i18next": "26.3.1",
    "jotai": "2.20.0",
    "lodash": "4.18.1",
    "next": "16.2.7",
    "postcss": "8.5.15",
    "next-sitemap": "4.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "17.0.8",
    "motion": "12.40.0",
    "react-popper-tooltip": "4.4.2",
    "recharts": "3.9.0",
    "safe-stable-stringify": "2.5.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.0",
    "type-fest": "5.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "viem": "2.52.0",
    "wagmi": "3.4.3",
    "zod": "4.4.3"
  },
  "overrides": {
    "typescript-eslint": "8.60.1",
    "@typescript-eslint/eslint-plugin": "8.60.1"
  },
  "packageManager": "bun@1.3.9"
}
