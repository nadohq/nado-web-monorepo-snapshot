op/dev/nado/nado-web-monorepo/packages/react-client/utils/toNonEmptyChainList.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/utils/truncate.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/context/evm/consts/rpcUrls.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/hooks/markets/useXStocksExchangeRates.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/utils/xStocks/getRoundedIncrement.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/utils/xStocks/index.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/utils/xStocks/xStocksConversions.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/hooks/query/useQueryCountryCode.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/utils/calcs/perp/getSafeIsoMaxLeverage.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/context/evm/utils/getCreateWagmiConfigParams.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/context/evm/utils/getPrimaryChainEnvOrDefault.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/context/metadata/productMetadata/marketDescriptions.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/utils/formatNumber/getPrecisionFixedFormatSpecifier.ts",[],[],"/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/utils/formatNumber/precisionFixed.ts",[],[],{"ruleId":"829","severity":2,"message":"830","line":114,"column":5,"nodeType":null,"endLine":114,"endColumn":30,"suppressions":"831"},"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/frankjia/Desktop/dev/nado/nado-web-monorepo/packages/react-client/context/subaccount/BaseSubaccountContextProvider.tsx:114:5\n  112 |   useEffect(() => {\n  113 |     // eslint-disable-next-line react-hooks/set-state-in-effect -- Only run on subaccount changes\n> 114 |     setLinkedSignerForSession(undefined);\n      |     ^^^^^^^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  115 |   }, [currentSubaccount]);\n  116 |\n  117 |   // Consolidate signing preference with any session state",["832"],{"kind":"833","justification":"834"},"directive","Only run on subaccount changes"]